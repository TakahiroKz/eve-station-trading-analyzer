# Región de EVE Online a monitorear (10000002 = The Forge / Jita)
ESI_REGION_ID=10000002
ESI_BASE_URL=https://esi.evetech.net/latest
ESI_USER_AGENT=eve-market-screener (contacto: tu_email@ejemplo.com)

# Usuario con el que corren los contenedores (debe ser el dueño de ./storage y ./credentials
# en el host: en la VM de Oracle, el usuario ubuntu = `id -u` / `id -g`). Por defecto 1000.
APP_UID=1000
APP_GID=1000

# Ruta a la base de datos SQLite
DB_PATH=./storage/market.db

# Ruta local del registro acumulativo de oportunidades
EXCEL_REGISTRO_PATH=./reporting/eve-calculator-registro.xlsx

# Threads concurrentes del motor de mercado para traer histórico/categorías de la ESI.
# Default 20 pensado para una máquina de desarrollo con RAM de sobra -- en hosts chicos
# (ej. VM Always Free de Oracle, 1GB RAM) bajarlo a 3-5 para evitar swap thrashing.
MAX_INGEST_WORKERS=20


# EVE SSO / ESI OAuth - registrar la app en https://developers.eveonline.com/applications
ESI_SSO_CLIENT_ID=
ESI_SSO_CLIENT_SECRET=
ESI_SSO_CALLBACK_URL=http://localhost:8765/callback
ESI_SSO_SCOPES=esi-wallet.read_character_wallet.v1 esi-markets.read_character_orders.v1 esi-ui.open_window.v1
ESI_REFRESH_TOKEN_PATH=./credentials/esi_refresh_token.txt

# % del ISK del wallet a usar como tamaño de posición por ítem en el screening automático
POSITION_SIZE_PCT_OF_WALLET=0.10

# Bot de Telegram (creado con @BotFather). Avisa de: cambios en tus órdenes (undercuts, ejecuciones,
# cierres) y fallas de servicio (watchdog). Solo cuando hay novedades, sin horario fijo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Avisos de oportunidades nuevas POTENCIAL: suspendidos (demasiada información). 1 = volver a activarlos.
TELEGRAM_NOTIFY_OPPORTUNITIES=0
# Opcional: otra base para la API de Telegram (solo pruebas, por ejemplo una dirección que no responde
# para comprobar que un Telegram caído no alarga el ciclo). Por defecto https://api.telegram.org
# TELEGRAM_API_BASE=

# Backup diario de storage/market.db a Oracle Object Storage (scripts/backup_db.sh).
# URL de una Pre-Authenticated Request de tipo "Bucket" con
# "Permit object writes", terminada en "/o/" tal como la muestra Oracle al crearla —
# ver OPERATIONS.md para el paso a paso. Sin configurar, el backup se saltea solo.
ORACLE_BACKUP_PAR_URL=

# Páginas del libro de órdenes de la región que se piden a la vez (1 = en serie). The Forge son
# ~416 páginas por ciclo de precios; con 8 en paralelo la descarga baja de ~80 s a unos pocos segundos.
ESI_ORDERS_WORKERS=8

# Registro de oportunidades (opportunity_log): cada ítem se anota como mucho una vez por intervalo (y
# siempre que cambia de estado); antes se anotaba en cada ciclo y la tabla llegó a 1,5 GB. La app solo
# muestra la última fila del ítem. Valores por defecto: 60 min (estados útiles), 720 min (DESCARTADO) y
# 3 días de retención (se purga en cada ciclo, hasta 200 mil filas por ciclo).
# OPPORTUNITY_LOG_INTERVAL_MIN=60
# OPPORTUNITY_LOG_DISCARDED_INTERVAL_MIN=720
# OPPORTUNITY_LOG_RETENTION_DAYS=3

# Horas de snapshots de órdenes que se conservan en market_snapshot (el motor de mercado
# borra los más viejos en cada corrida; solo el último de cada ítem se usa). Con el ciclo
# rápido cada pocos minutos, más horas = una tabla mucho más grande. SNAPSHOT_RETENTION_DAYS
# (versiones anteriores) se sigue entendiendo si SNAPSHOT_RETENTION_HOURS no está.
SNAPSHOT_RETENTION_HOURS=6

# --- Cuentas de visitantes con EVE SSO (opcional; apagado si falta alguna) ---
# Registra una aplicación en https://developers.eveonline.com con callback https://evemarket-analyzer.online/api/auth/callback
# y los scopes esi-skills.read_skills.v1, esi-characters.read_standings.v1, esi-wallet.read_character_wallet.v1.
EVE_LOGIN_CLIENT_ID=
EVE_LOGIN_CLIENT_SECRET=
EVE_LOGIN_CALLBACK_URL=https://evemarket-analyzer.online/api/auth/callback
# Claves AES-256 (urlsafe base64) para cifrar los refresh tokens; la primera cifra, todas descifran.
# Generar: python scripts/users_admin.py genkey   Rotar: anteponer la nueva y `python scripts/users_admin.py rotate`.
USERS_ENC_KEYS=
# Opcional: por defecto ./storage/users.db (junto a market.db).
# USERS_DB_PATH=
