# Región de EVE Online a monitorear (10000002 = The Forge / Jita)
ESI_REGION_ID=10000002
ESI_BASE_URL=https://esi.evetech.net/latest
ESI_USER_AGENT=eve-market-screener (contacto: tu_email@ejemplo.com)

# Ruta a la base de datos SQLite
DB_PATH=./storage/market.db

# Ruta local del registro acumulativo de oportunidades
EXCEL_REGISTRO_PATH=./reporting/eve-calculator-registro.xlsx

# Threads concurrentes del motor de mercado para traer histórico/categorías de la ESI.
# Default 20 pensado para una máquina de desarrollo con RAM de sobra -- en hosts chicos
# (ej. VM Always Free de Oracle, 1GB RAM) bajarlo a 3-5 para evitar swap thrashing.
MAX_INGEST_WORKERS=20


# EVE SSO / ESI OAuth - registrar la app en https://developers.eveonline.com/applications
ESI_SSO_CLIENT_ID=
ESI_SSO_CLIENT_SECRET=
ESI_SSO_CALLBACK_URL=http://localhost:8765/callback
ESI_SSO_SCOPES=esi-wallet.read_character_wallet.v1 esi-markets.read_character_orders.v1 esi-ui.open_window.v1
ESI_REFRESH_TOKEN_PATH=./credentials/esi_refresh_token.txt

# % del ISK del wallet a usar como tamaño de posición por ítem en el screening automático
POSITION_SIZE_PCT_OF_WALLET=0.10

# Bot de Telegram (creado con @BotFather) para avisar de nuevas oportunidades POTENCIAL
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backup diario de storage/market.db a Oracle Object Storage (scripts/backup_db.sh, D10
# en DEUDA_TECNICA.md). URL de una Pre-Authenticated Request de tipo "Bucket" con
# "Permit object writes", terminada en "/o/" tal como la muestra Oracle al crearla —
# ver OPERATIONS.md para el paso a paso. Sin configurar, el backup se saltea solo.
ORACLE_BACKUP_PAR_URL=

# Días de snapshots de órdenes que se conservan en market_snapshot (el motor de mercado
# borra los más viejos en cada corrida; solo el último de cada ítem se usa).
SNAPSHOT_RETENTION_DAYS=7
